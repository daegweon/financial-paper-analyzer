# Isolated experiment only: same backend layout/test command as the existing gate.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONPATH=/app:/
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
COPY backend/requirements-dev.txt /app/requirements-dev.txt
COPY backend/requirements-tables-experiment.txt /app/requirements-tables-experiment.txt
RUN pip install --no-cache-dir -r requirements-dev.txt -r requirements-tables-experiment.txt
COPY backend/app/ /app/app/
COPY backend/tests/ /app/tests/
COPY backend/pytest.ini /app/pytest.ini
COPY benchmark/ /benchmark/
RUN pytest -q
USER 65532:65532
CMD ["python", "-m", "benchmark.cell_review_run"]
