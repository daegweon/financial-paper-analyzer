# Isolated PDF extraction + frozen existing-claim revalidation; no model calls.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /bench
COPY backend/requirements-ranked-oss.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/app/__init__.py backend/app/main.py backend/app/pdf_replacement.py /bench/app/
COPY benchmark/__init__.py benchmark/evaluate.py benchmark/table_shadow.py benchmark/full_analysis_ab.py benchmark/full_analysis_replay.py benchmark/oss_ranked_trial.py benchmark/table_corpus.sha256.json /bench/benchmark/
COPY backend/tests/test_oss_ranked_trial.py /bench/tests/
ENV PYTHONPATH=/bench
RUN python -m pytest -q tests/test_oss_ranked_trial.py && python -c "import app.main; assert app.main.ANALYSIS_VERSION == 'finance-structured-v6.4.2'"
USER 65532:65532
CMD ["python", "-m", "benchmark.oss_ranked_trial"]
