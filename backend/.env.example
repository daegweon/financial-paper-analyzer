AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Future provider switch: set AI_PROVIDER=openai and configure the key below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
FRONTEND_ORIGIN=http://localhost:3000

# Server-only Supabase service role key. Never expose this value to NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Set only after verifying the Google AI Studio billing tier for this project.
# Allowed values: free, paid_standard. Leave unset/unknown if not confirmed.
GEMINI_BILLING_MODE=unknown

# Comma-separated Supabase Auth user UUIDs allowed to access /admin/ai-usage.
# Keep empty until an administrator has been explicitly designated.
PAPERSIGNAL_ADMIN_USER_IDS=

# Optional initial service-wide monthly AI budget in USD. A saved ai_admin_settings
# value takes precedence. This is an admin reporting threshold, not a hard quota.
PAPERSIGNAL_ADMIN_MONTHLY_AI_BUDGET_USD=
